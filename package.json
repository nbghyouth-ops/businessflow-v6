{
  "name": "business-flow",
  "version": "6.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "pretest:integration": "node scripts/db-up.mjs --ensure",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "node scripts/db-down.mjs",
    "db:status": "node scripts/db-status.mjs",
    "predb:check": "node scripts/db-up.mjs --ensure",
    "test:e2e": "playwright test",
    "test:egress": "playwright test tests/e2e/egress.spec.ts --project=desktop",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "db:check": "node scripts/preflight.mjs",
    "db:load:reset": "node scripts/db-load-reset.mjs",
    "db:load:fresh": "node scripts/db-load-reset.mjs --fresh --truncate",
    "db:load:truncate": "node scripts/db-load-reset.mjs --truncate",
    "load:suite": "node scripts/run-load-suite.mjs",
    "chaos:r11i": "node scripts/run-chaos-r11i.mjs",
    "load:seed:tenants": "vitest run tests/load/seed-load-tenants.test.ts",
    "smoke": "node scripts/smoke-api.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm audit --omit=dev && npm run scan:record-only && npm run scan:tokens && npm run scan:simulation && npm run scan:outbound && npm run scan:nopay && npm run scan:nofp && npm run scan:logo && npm run i18n && npm run test:egress && npm run smoke && node scripts/smoke-v6.mjs",
    "scan:tokens": "node scripts/codemod-tokens.mjs --check",
    "verify:release": "node scripts/verify-release.mjs",
    "scan:record-only": "node scripts/scan-record-only.mjs",
    "scan:simulation": "node scripts/scan-simulation.mjs",
    "scan:outbound": "node scripts/scan-outbound.mjs",
    "verify:completion": "node scripts/verify-completion.mjs",
    "i18n": "node scripts/check-i18n.mjs",
    "scan:nopay": "node scripts/scan-nopay.mjs",
    "scan:nofp": "node scripts/scan-nofp.mjs",
    "scan:logo": "node scripts/scan-logo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@esbuild-kit/esm-loader": "^2.6.5",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.23",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "next": "16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@esbuild-kit/core-utils": "^3.3.2",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/exceljs": "^0.5.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jose": "6.2.17",
    "jsdom": "27.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.3",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  },
  "overrides": {
    "postcss": "8.5.33",
    "dompurify": "3.4.17",
    "uuid": "^11.1.1",
    "esbuild": "^0.25.0"
  }
}
