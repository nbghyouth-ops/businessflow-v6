# Business Flow — daftar variabel lingkungan (nama saja, tanpa nilai).
# Lima variabel berikut WAJIB untuk produksi. Build dan impor modul TIDAK memerlukan
# satu pun variabel ini; server hanya menolak permintaan yang benar-benar membutuhkannya.
#
# Neon pooled (region Singapore). Selalu tulis sslmode=verify-full secara eksplisit
# agar driver `pg` tidak memakai sslmode longgar secara diam-diam.
DATABASE_URL=
# >= 32 karakter. Dibuat acak, jangan di-commit.
BETTER_AUTH_SECRET=
# Origin publik aplikasi, HARUS sama persis dengan domain production dan redirect URI Google.
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Opsional — hanya untuk build Android (Capacitor). Tidak dipakai web produksi.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
CAP_SERVER_URL=
